digraph "python.getattribute_fallback.cg" {
  graph [rankdir="LR"];
  node [shape=rectangle];
  "Dynamic.__getattr__";
  "Dynamic.__getattribute__";
  "Dynamic.unrelated";
  "run attribute read";
  "run attribute read" -> "Dynamic.__getattribute__";
  "run attribute read" -> "Dynamic.__getattr__";
  // forbidden: "run attribute read" -> "Dynamic.unrelated"
}
